# --- App ---
APP_ENV=development
PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database ---
# DATABASE_DRIVER selects the storage backend: postgres, mysql, sqlite, or mongodb.
# All four store the exact same data (metadata cache, jobs, fetch/download stats) — never the
# downloaded media itself — so any one of them works with the rest of the app unchanged.
DATABASE_DRIVER=sqlite

# Connection string for postgres/mysql/mongodb (not used for sqlite).
#   postgres: postgres://user:password@localhost:5432/blazfetch
#   mysql:    mysql://user:password@localhost:3306/blazfetch
#   mongodb:  mongodb://localhost:27017/blazfetch
DATABASE_URL=

# File path used only when DATABASE_DRIVER=sqlite. Created automatically if it doesn't exist —
# no server or credentials needed, the fastest way to try the backend with zero setup.
DATABASE_SQLITE_PATH=./data/blazfetch.sqlite3
DATABASE_SSL=false

# --- System binaries ---
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Timeouts (ms) ---
FETCH_TIMEOUT_MS=25000
REDIRECT_RESOLVE_TIMEOUT_MS=8000
FALLBACK_TIMEOUT_MS=15000
DOWNLOAD_START_TIMEOUT_MS=15000
DOWNLOAD_TOTAL_TIMEOUT_MS=600000
FFMPEG_TIMEOUT_MS=180000
PROXY_STREAM_TIMEOUT_MS=600000

# --- Concurrency ---
MAX_CONCURRENT_DOWNLOADS_GLOBAL=10
# H.264/MP3 conversions allowed at once (the rest wait their turn); 0 = half the CPU cores
MAX_CONCURRENT_CONVERSIONS=0
# CPU threads per conversion; 0 = the cores shared between the conversions allowed at once
FFMPEG_THREADS=0
# yt-dlp/ffmpeg priority (nice 0-19) so the API stays responsive while they work; 0 = normal priority
MEDIA_PROCESS_NICE=10
# Refuse downloads that must be prepared on disk while TEMP_DIR has less free space than this
MIN_FREE_DISK_MB=1024
# Downloads a visitor may run at once, counted separately for video and for audio: with the default of 1 a guest can have one video AND one
# audio download running together (a video download does not block an audio preview), but not two videos. (Recommended: leave as is.)
MAX_CONCURRENT_DOWNLOADS_PER_USER=2
MAX_CONCURRENT_DOWNLOADS_PER_GUEST=1
# Guests on one IP address (an office, a mobile carrier) share this many downloads, again per kind (video / audio).
MAX_CONCURRENT_DOWNLOADS_PER_IP=5
MAX_CONCURRENT_FETCHES_GLOBAL=20

# --- Limits ---
MAX_PLAYLIST_ITEMS=200
MAX_DOWNLOAD_SIZE_BYTES=2147483648
# auto mode falling back to prepare (VP9/AV1/HEVC pick) uses the quicker "Fastest" ffmpeg preset once the source is
# at least this big, trading a somewhat larger output for less server time on the videos where that matters most.
AUTO_FALLBACK_FAST_CONVERT_MIN_BYTES=104857600
# On by default, to protect your server: once a video's real downloaded size reaches UNSAFE_LARGE_VIDEO_MIN_BYTES,
# the compatibility transcode is skipped and the video is delivered in its original codec (VP9/AV1/HEVC etc.)
# instead of being converted to H.264 — trading playability on some phones for saving that conversion's CPU cost.
# This applies to every download mode, including an explicit mode=prepare ("Compatible") — above the size limit,
# even Compatible mode no longer guarantees a playable file. Videos under the limit are always made to play
# everywhere, regardless of this setting. Set to false to always guarantee playability, however big the video is
# (uses more server CPU for large videos in an incompatible codec).
UNSAFE_LARGE_VIDEO_STREAM_ENABLED=true
# The size (in bytes) at which the switch above kicks in. 104857600 = 100 MB. Raise or lower this to change what
# counts as "large" for your server.
UNSAFE_LARGE_VIDEO_MIN_BYTES=104857600
TEMP_DIR=./tmp
# Direct-stream endpoint (GET /api/v1/stream): pipes the download to the client with no temp file.
STREAM_MODE_ENABLED=true
# Default delivery mode for GET /api/v1/stream when the request has no ?mode=:
#   stream  = pipe straight through, nothing on disk; merges and HLS are piped live too. If it fails before the
#             first byte the request falls back to prepare (default)
#   auto    = the same, with balanced conversion settings on the fallback (RECOMMENDED for a public site)
#   prepare = build the file on the server first (H.264/AAC guaranteed), then send it. Puts the most load on the server
# The official frontend always sends ?mode= itself (Automatic, Fastest or Compatible), so this is only the default for other clients.
DEFAULT_DOWNLOAD_MODE=stream
# Anything in TEMP_DIR older than this is deleted by a periodic sweep (defaults: 1 hour, every 10 minutes).
TEMP_SWEEP_MAX_AGE_MS=3600000
TEMP_SWEEP_INTERVAL_MS=600000
# GET /stats' "online" count: a visitor counts while their live-stats connection has touched presence
# within this long (the connection itself heartbeats every 15s, so this only needs to survive a couple of
# missed ones). Backed by the database, so it stays correct across multiple API instances behind Nginx.
ONLINE_VISITOR_WINDOW_SECONDS=60

# Deliver every audio download as MP3. Sources that are not MP3 already are converted through ffmpeg: piped live in
# stream mode, or saved to a temporary file, converted, sent, then deleted in prepare/job mode.
# RECOMMENDED: true, so every audio download is an MP3 that plays everywhere (and the frontend's audio preview works on every row).
# If the line is left out, the built-in default is false: audio keeps its original format, e.g. M4A/Opus. Restart after changing.
AUDIO_FORCE_MP3=true

# --- Cache ---
# Stored media is kept forever. These control when it is refreshed or re-checked:
# how long the direct media URLs in a stored response are trusted (seconds)
CACHE_TTL_SECONDS=3600
# refresh stored playlists after this long (YouTube Mixes use CACHE_TTL_SECONDS)
PLAYLIST_REFRESH_SECONDS=86400
# re-check that each stored item still exists: every 7 days, in the background and on demand
REVALIDATE_AFTER_SECONDS=604800
REVALIDATE_ENABLED=true
REVALIDATE_INTERVAL_MS=1800000
REVALIDATE_BATCH_SIZE=10
REVALIDATE_DELAY_MS=3000
# consecutive "not found / private" answers before an item is marked unavailable
UNAVAILABLE_AFTER_FAILURES=2
TRANSIENT_RETRY_SECONDS=3600
UNAVAILABLE_RECHECK_SECONDS=600

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GUEST=30
RATE_LIMIT_MAX_USER=120
RATE_LIMIT_MAX_DOWNLOAD=10
# Per-IP ceiling: this many times the per-visitor limits above (needs TRUST_PROXY behind a proxy).
RATE_LIMIT_IP_MULTIPLIER=10

# --- Fallback providers ---
INSTAGRAM_FALLBACK_MAX_RETRIES=3
INSTAGRAM_FALLBACK_RETRY_DELAY_MS=1000
# Optional: path to a Netscape-format cookies.txt exported from a browser logged into an
# Instagram account. Never fetched or generated automatically. Single posts/reels/carousels
# work without it.
INSTAGRAM_COOKIES_PATH=
# YouTube blocks an IP for a while when it sees many requests ("Sign in to confirm you're not a bot").
# When yt-dlp fails that way the fallback provider serves the request; after a block, yt-dlp is skipped
# for the cooldown so the block is not extended.
# direct links from fallback providers die within a minute, so stored ones are trusted this long (seconds)
FALLBACK_LINK_TTL_SECONDS=30
YOUTUBE_FALLBACK_ENABLED=true
YOUTUBE_FALLBACK_ATTEMPTS=2
YOUTUBE_BLOCK_COOLDOWN_SECONDS=600
CAKKATROK_MAX_ATTEMPTS=1
CAKKATROK_API_BASE=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app: 1 behind Nginx, 0 when clients connect directly.
TRUST_PROXY=0

# ---- Cloudflare Turnstile (optional bot check) ------------------------------------------------------------
# Off by default. To turn it on: create a widget at https://dash.cloudflare.com/?to=/:account/turnstile, then set
# TURNSTILE_ENABLED=true and paste its site key and secret key. Fetching, streaming and downloading then need a
# passed check (the frontend shows the widget by itself). For local testing, Cloudflare's dummy keys always pass:
#   site key 1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# How long a passed check lasts before the visitor is asked again (seconds)
TURNSTILE_SESSION_SECONDS=1800
# Optional Siteverify checks (the action is also sent to the frontend widget).
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_EXPECTED_ACTION=
