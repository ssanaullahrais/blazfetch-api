# --- App ---
APP_ENV=development
PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database ---
# DATABASE_DRIVER selects the storage backend: postgres, mysql, sqlite, or mongodb.
# All four store the exact same data (metadata cache, jobs, fetch/download stats) — never the
# downloaded media itself — so any one of them works with the rest of the app unchanged.
DATABASE_DRIVER=postgres

# Connection string for postgres/mysql/mongodb (not used for sqlite).
#   postgres: postgres://user:password@localhost:5432/blazfetch
#   mysql:    mysql://user:password@localhost:3306/blazfetch
#   mongodb:  mongodb://localhost:27017/blazfetch
DATABASE_URL=postgres://blazfetch:blazfetch@localhost:5432/blazfetch

# File path used only when DATABASE_DRIVER=sqlite. Created automatically if it doesn't exist —
# no server or credentials needed, the fastest way to try the backend with zero setup.
DATABASE_SQLITE_PATH=./data/blazfetch.sqlite3
DATABASE_SSL=false

# --- System binaries ---
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Timeouts (ms) ---
FETCH_TIMEOUT_MS=25000
REDIRECT_RESOLVE_TIMEOUT_MS=8000
FALLBACK_TIMEOUT_MS=15000
DOWNLOAD_START_TIMEOUT_MS=15000
DOWNLOAD_TOTAL_TIMEOUT_MS=600000
FFMPEG_TIMEOUT_MS=180000
PROXY_STREAM_TIMEOUT_MS=600000

# --- Concurrency ---
MAX_CONCURRENT_DOWNLOADS_GLOBAL=10
MAX_CONCURRENT_DOWNLOADS_PER_USER=2
MAX_CONCURRENT_DOWNLOADS_PER_GUEST=1
MAX_CONCURRENT_FETCHES_GLOBAL=20

# --- Limits ---
MAX_PLAYLIST_ITEMS=200
MAX_DOWNLOAD_SIZE_BYTES=2147483648
TEMP_DIR=./tmp

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GUEST=30
RATE_LIMIT_MAX_USER=120
RATE_LIMIT_MAX_DOWNLOAD=10

# --- Fallback providers ---
INSTAGRAM_FALLBACK_MAX_RETRIES=3
INSTAGRAM_FALLBACK_RETRY_DELAY_MS=1000
# Optional: path to a Netscape-format cookies.txt exported from a browser logged into an
# Instagram account authorized to view the profiles this deployment will list. Never fetched or
# generated automatically. Required only for listing a profile's posts (Instagram requires a
# logged-in session for that even on public accounts); single posts/reels/carousels work without it.
INSTAGRAM_COOKIES_PATH=
# Preferred profile-listing engine: Instaloader (https://instaloader.github.io/).
# pip install instaloader, then create a session yourself with:
#   instaloader --login <your_username>
# and point these at it. Both must be set together; Instaloader is used over
# INSTAGRAM_COOKIES_PATH when both are configured.
PYTHON_PATH=python
INSTAGRAM_INSTALOADER_SESSION_PATH=
INSTAGRAM_INSTALOADER_SESSION_USERNAME=
INSTALOADER_TIMEOUT_MS=30000
CAKKATROK_MAX_ATTEMPTS=1
CAKKATROK_API_BASE=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
